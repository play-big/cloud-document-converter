{
  "extends": "@dolphin/typescript-config/app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.pages.tsbuildinfo",
    "types": ["@dolphin/common/env", "@types/firefox-webext-browser"],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/pages/**/*.ts",
    "src/pages/**/*.vue",
    "src/vue.d.ts",
    "src/browser-types.d.ts"
  ]
}
