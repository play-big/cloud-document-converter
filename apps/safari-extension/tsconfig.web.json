{
  "extends": "@dolphin/typescript-config/app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.web.tsbuildinfo",
    "types": ["@dolphin/common/env"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/scripts/*.ts",
    "src/common/*.ts",
    "src/lib/*.ts",
    "src/components/**/*.ts"
  ]
}
