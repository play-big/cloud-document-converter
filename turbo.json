{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "outputs": ["dist/**"],
      "dependsOn": ["^build"],
      "inputs": ["apps/*/src/**/*", "packages/**/src/**/*"],
      "cache": true
    },
    "build:safari": {
      "outputs": ["dist/**", "CloudDocumentConverter Extension/Resources/**"],
      "dependsOn": ["@dolphin/extension-shared#build", "@dolphin/lark#build", "@dolphin/common#build"],
      "cache": true
    },
    "type-check": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
